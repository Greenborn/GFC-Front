# Archivo de ejemplo para variables de entorno
# Copia este archivo como .env y ajusta los valores según tu entorno

# URLs de la API
API_BASE_URL=https://gfc.prod-api.greenborn.com.ar/
NODE_API_BASE_URL=https://gfc.api2.greenborn.com.ar/api/

# Configuración de autenticación
LOGIN_ACTION=login

# Configuración de la aplicación
APP_NAME=app_gfc_prod-
APP_VERSION=1.20.64

# Para desarrollo local, puedes usar:
# API_BASE_URL=http://localhost:8888/

IMAGES_BASE_URL=https://assets.prod-gfc.greenborn.com.ar
SSO_BASE_URL=https://auth.greenborn.com.ar
SSO_REDIRECT=/#/login-redirect
WS_URL=https://gfc.api2.greenborn.com.ar